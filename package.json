{
  "name": "download-nexus",
  "version": "1.1.9",
  "description": "A browser extension that intercepts magnet links and torrent files on web pages and routes them to your download services (Synology, qBittorrent, Transmission, Deluge).",
  "main": "background.js",
  "scripts": {
    "build": "node scripts/build.js chrome",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "zip:chrome": "node scripts/create-zip.js chrome",
    "zip:firefox": "node scripts/create-zip.js firefox",
    "package": "npm run build:all && npm run zip",
    "test": "jest",
    "test:unit": "jest tests/adapters.test.js tests/linkDetector.test.js tests/serviceFilter.test.js tests/background.test.js",
    "test:adapters": "jest tests/adapters.test.js",
    "test:adapters:real": "jest --testPathPattern=\"-adapter.test.js$\"",
    "test:link-detector": "jest tests/linkDetector.test.js",
    "test:service-filter": "jest tests/serviceFilter.test.js",
    "test:background": "jest tests/background.test.js",
    "test:options": "jest tests/options.test.js",
    "test:crypto": "jest tests/crypto.test.js",
    "test:jdownloader": "jest tests/jdownloader-adapter.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:transmission": "jest tests/transmission-integration.test.js",
    "test:deluge": "jest tests/deluge-integration.test.js",
    "test:jdownloader:integration": "jest tests/jdownloader-integration.test.js",
    "test:integration:all": "jest --testPathPattern=integration.test.js",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "pretest:e2e": "npm run build:all",
    "test:e2e": "playwright test",
    "pretest:e2e:headed": "npm run build:chrome",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "pretest:e2e:chrome": "npm run build:chrome",
    "test:e2e:chrome": "playwright test --project=chromium",
    "pretest:e2e:cross-browser": "npm run build:all",
    "test:e2e:cross-browser": "playwright test --project=chrome --project=edge",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:init": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "dev:browser": "node scripts/launch-browser.js",
    "debug:inspect": "node scripts/inspect-browser.js",
    "debug:logs": "node scripts/inspect-browser.js --logs",
    "debug:storage": "node scripts/inspect-browser.js --storage",
    "debug:reload": "node scripts/inspect-browser.js --reload",
    "debug:listen": "node scripts/inspect-browser.js --listen"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craigpen/download-nexus.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/craigpen/download-nexus/issues"
  },
  "homepage": "https://github.com/craigpen/download-nexus#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.1.43",
    "conventional-changelog-cli": "^4.1.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.5.1",
    "sharp": "^0.35.3",
    "ws": "^8.21.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!dist/**"
    ]
  }
}
