{
  "name": "nas-download-helper",
  "version": "1.1.5",
  "description": "A browser extension for Edge/Chrome that intercepts magnet links and torrent files on web pages and sends them to your NAS device(s).",
  "main": "background.js",
  "scripts": {
    "build": "node scripts/build.js chrome",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "zip:chrome": "node scripts/create-zip.js chrome",
    "zip:firefox": "node scripts/create-zip.js firefox",
    "package": "npm run build:all && npm run zip",
    "test": "jest",
    "test:adapters": "jest tests/adapters.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:transmission": "jest tests/transmission-integration.test.js",
    "test:all": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craigpen/nas-download-helper.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/craigpen/nas-download-helper/issues"
  },
  "homepage": "https://github.com/craigpen/nas-download-helper#readme",
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "jest": "^29.0.0",
    "sharp": "^0.35.3",
    "ws": "^8.21.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "background.js",
      "popup.js",
      "content.js",
      "!dist/**"
    ]
  }
}
